# Database (used by Docker Compose; local CLI without DATABASE_URL uses SQLite under CLIPYYY_HOME)
POSTGRES_DB=clipyyy
POSTGRES_USER=clipyyy
POSTGRES_PASSWORD=change-me-in-production
# DATABASE_URL=postgresql+psycopg://clipyyy:change-me-in-production@postgres:5432/clipyyy

# Application-level encryption key for stored OAuth tokens (Fernet 32-byte url-safe base64 key)
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=

# Google OAuth 2.0 / YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/youtube/callback

# LLM Providers (optional; can also be configured in Settings)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Optional integrations
# PEXELS_API_KEY=
# BUFFER_API_KEY=

